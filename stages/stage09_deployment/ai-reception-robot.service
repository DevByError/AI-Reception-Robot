# AI-Reception-Robot as a systemd USER service (Linux / Jetson): starts at login, restarts on a crash.
#
#   mkdir -p ~/.config/systemd/user
#   cp stages/stage09_deployment/ai-reception-robot.service ~/.config/systemd/user/
#   # edit WorkingDirectory below if the project is not in ~/AI-Reception-Robot
#   systemctl --user daemon-reload
#   systemctl --user enable --now ai-reception-robot
#   journalctl --user -u ai-reception-robot -f          # the robot's log
#
# A user service (not a system one) so it can open the screen, camera and sound of the logged-in
# user. To start without anybody logging in: sudo loginctl enable-linger $USER

[Unit]
Description=AI-Reception-Robot
After=graphical-session.target sound.target network-online.target

[Service]
WorkingDirectory=%h/AI-Reception-Robot
ExecStart=%h/AI-Reception-Robot/.venv/bin/python stages/stage08_orchestrator/main_live.py
# The face full screen, no camera debug window. HEADLESS=true for a robot with no screen.
Environment=CAMERA_PREVIEW=false
Environment=FACE_FULLSCREEN=true
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
