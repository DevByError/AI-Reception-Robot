# Line endings. This project is written on Windows and deployed on a Linux/Jetson kiosk, so the
# two shell scripts have to keep the endings their own interpreter accepts: bash fails on a
# setup.sh with CRLF ("bad interpreter: /usr/bin/env bash^M"), and PowerShell is fine either way
# but stays CRLF for consistency with the rest of the Windows tooling.
* text=auto

*.sh   text eol=lf
*.ps1  text eol=crlf

# Binaries - never newline-translate these, and don't try to diff them as text.
*.wav  binary
*.onnx binary
*.pt   binary
*.npz  binary
*.png  binary
*.jpg  binary
