# MySQL connection for the robot's persistent memory (enrolled faces + conversation
# transcripts). See stages/stage02_face_recognition/robot_db.py.
#
# Copy this file to `.env` in this same folder and fill in your own password:
#     copy .env.example .env          (Windows)
#     cp .env.example .env            (Linux/macOS)
#
# `.env` is gitignored - it holds a real password and must never be committed. Anything already
# set as a real environment variable wins over this file, which is how the deployed kiosk should
# supply its credentials rather than shipping a file.

# --- MySQL: persistent memory (faces + conversation transcripts) -----------------------------
# 127.0.0.1 forces TCP; "localhost" also works and is what a Workbench connection usually says.
LUC_DB_HOST=127.0.0.1
LUC_DB_PORT=3306
LUC_DB_USER=root
LUC_DB_PASSWORD=
LUC_DB_NAME=ai_reception_robot
# auto (default): MySQL when it answers, otherwise a local SQLite file (data/robot_memory.db) -
# so the robot keeps its memory even with no MySQL installed. mysql / sqlite force one.
# LUC_DB_BACKEND=auto
# LUC_DB_SQLITE_PATH=data/robot_memory.db

# --- Ollama: the local LLM, used when the cloud API is missing or down ------------------------
# All optional - these are the defaults, shown so they're easy to change. See
# stages/stage05_nlu_dialogue/README.md ("Local LLM via Ollama") for the one-time install and
# for why llama3.2:3b rather than a bigger model.
# LUC_OLLAMA_HOST=http://127.0.0.1:11434
# LUC_OLLAMA_CHAT_MODEL=llama3.2:3b
# LUC_OLLAMA_EMBED_MODEL=nomic-embed-text

# Which model produces the RAG vectors: "auto" (default: the ONNX copy of all-MiniLM-L6-v2 in
# models/ - identical vectors, no PyTorch - else "sentence-transformers"), "sentence-transformers"
# (in-process, no server needed) or "ollama" (nomic-embed-text). NOT a speed setting - measured here, Ollama embeddings
# are ~35x slower on real chunks (~106 minutes to rebuild the knowledge base vs ~3), and both
# models score identically on the current retrieval test set. Switching also invalidates the
# on-disk knowledge-base cache. Leave this alone unless retrieval is demonstrably picking the
# wrong chunk - see stages/stage05_nlu_dialogue/README.md for the measurements.
# LUC_EMBEDDING_BACKEND=auto

# --- Cloud LLM (optional) --------------------------------------------------------------------
# With a key set, the robot uses it first and falls back to the local Ollama model when it fails.
# With no key, the local model is the only LLM. With neither, answers come straight from the
# knowledge base and general conversation is off.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# How long ONE Gemini call may take before it is abandoned and the chain moves to the next
# backend (seconds). This exists because the google-genai SDK retries 429/503 internally with
# backoff before raising: measured 2026-09-17, a single call against a quota-exhausted key took
# 70.6 SECONDS to fail, and the robot's own no-search retry doubled it - one visitor waited 249s
# for an answer the local Ollama model produces in under two.
#
# 10s is the API's own minimum; Gemini rejects anything shorter with a 400 on EVERY call, which
# takes the backend out completely. Values below 10 are raised to it with a warning.
#
# This is a per-call ceiling, not a per-question one: after two consecutive failures the chain
# parks Gemini for two minutes (see ChainAnswerGenerator's circuit breaker), so a sustained
# outage costs this wait roughly once per cooldown instead of once per question.
# GEMINI_TIMEOUT_S=10

# How often a backend that has been taken out of the chain is quietly re-checked, in seconds.
# Default 600 (10 minutes).
#
# When Gemini fails twice in a row it is PARKED: removed from the chain entirely, so no visitor
# question ever waits on it again - answers come from Ollama at full speed. A background thread
# then pings it with a tiny health-check call on this interval. The moment that succeeds (your
# quota reset, the outage ended, billing was enabled) Gemini goes straight back to the front of
# the chain and the next question uses it. Nobody waits for the discovery.
#
# The probe deliberately does NOT run on a visitor's question. That was the first design and it
# was wrong: whoever asked the first question after each cooldown still paid the full timeout.
# LLM_RECHECK_INTERVAL_S=600

# =============================================================================================
# REAL-TIME CONVERSATION
# =============================================================================================
# How the robot decides when you have finished talking, how fast it answers, and whether you can
# talk over it. All optional - every value shown is the default, so an empty .env behaves exactly
# as the robot does today.
#
# These are read by stages/stage00_setup/realtime_config.py. Run it to see what is actually in
# effect and where each value came from:
#     python stages/stage00_setup/realtime_config.py
#
# Each name also works with the LUC_ prefix (LUC_END_OF_TURN_TIMEOUT=...), which wins if both are
# set - matching the LUC_DB_*/LUC_OLLAMA_* settings above.

# --- turn detection: when does the robot decide you have finished? ---------------------------
# The four numbers that decide whether it waits or answers. They are a RANGE, not one threshold,
# and that is the point: a clearly-finished question is answered at MIN_SILENCE_DURATION, while
# somebody trailing off mid-thought gets all the way to MAX_SILENCE_DURATION. The evidence in
# between comes from the pitch contour of your last words and from whether the transcript reads
# as a finished sentence - see ADAPTIVE_ENDPOINTING in stage04's stt_listener_live.py.
#
# Raise MIN_SILENCE_DURATION if the robot cuts you off mid-sentence.
# Lower MAX_SILENCE_DURATION if it feels slow to answer when you have clearly finished.

# Earliest a turn can end, and only with positive evidence. Never on silence alone (ms).
# MIN_SILENCE_DURATION=550
# Hard stop. The turn ends here whatever the signals say (ms).
# MAX_SILENCE_DURATION=1500
# Used when the pitch contour cannot be read at all - very common, since English phrases ending
# on an unvoiced consonant ("computer science", "my class") have no measurable contour (ms).
# END_OF_TURN_TIMEOUT=900
# Below this, audio is a cough, a click or a door - discarded WITHOUT being sent to the model.
# This is the main defence against the robot answering background noise (ms).
# MIN_SPEECH_DURATION=400
# Safety cap: transcribe whatever has been recorded even if silence never arrives (seconds).
# MAX_UTTERANCE_S=15

# VAD_ENABLED=false falls back to a single fixed silence threshold instead of the adaptive
# endpointer above - the behaviour from before adaptive endpointing existed. Only worth doing if
# the adaptive version misbehaves on a room it was not tuned against.
# VAD_ENABLED=true

# How readily the microphone counts a sound as speech at all.
# 0 = most permissive, 3 = most aggressive about rejecting non-speech. Raising this does NOT
# make the robot better at ignoring noise - it makes it deaf to quiet opening consonants and
# clips your first word. Noise is screened out by MIN_SPEECH_DURATION instead.
# VAD_AGGRESSIVENESS=1
# Consecutive speech-flagged frames (30ms each) before recording starts - debouncing.
# SPEECH_START_FRAMES=4
# Frames kept from BEFORE speech was confirmed, so the first syllable is not clipped.
# PREROLL_FRAMES=20

# --- interruption (barge-in): can you talk over the robot? ------------------------------------
# auto  - measure this room at startup and switch it on only if the microphone can actually tell
#         your voice apart from the robot's own voice coming back through the speaker. THE
#         DEFAULT, and the honest one: whether barge-in works is a property of your hardware.
# true  - force it on even if the measurement says it will misfire. Expect the robot to interrupt
#         ITSELF on its own voice unless you have a directional mic or hardware echo cancellation.
# false - never calibrate, never interrupt. The robot finishes each answer before listening.
# INTERRUPTION_ENABLED=auto

# How far above the measured echo of the robot's own voice a sound must be to count as a person.
# Multiplier on RMS, so 2.5 is about 8dB. Raise it if the robot interrupts itself; lower it if
# you have to shout to interrupt it.
# BARGE_IN_MARGIN=2.5
# How long that louder speech must be SUSTAINED, so a cough or a door cannot stop it (ms).
# BARGE_IN_MIN_SPEECH_MS=330
# Ignored at the start of each spoken answer - playback has an attack transient, and your own
# last words can still be echoing in the room (ms).
# BARGE_IN_WARMUP_MS=700
# Above this measured echo level, `auto` refuses to enable barge-in as unreliable.
# BARGE_IN_MAX_ECHO_FLOOR=0.08
# Carry the words you interrupted WITH into the next listen, instead of discarding them. With
# this off you have to repeat the sentence you just interrupted with, which defeats the point.
# BARGE_IN_KEEP_AUDIO=true

# --- conversation flow --------------------------------------------------------------------------
# continuous   - after an answer the robot simply listens, the way a person does. It only asks
#                "do you have any other questions?" if you go quiet. THE DEFAULT.
# push_to_talk - the robot prompts after every single answer before it will listen again.
# CONVERSATION_MODE=continuous
# The same switch under the other name - setting either one to the hands-off value wins.
# CONTINUOUS_CONVERSATION=true

# --- streaming ------------------------------------------------------------------------------
# Partial transcripts while you are still talking. Costs a second Whisper pass over a growing
# buffer - turn it off on constrained hardware. Turn DETECTION is unaffected either way.
# STREAMING_STT=true
# PARTIAL_MIN_DURATION_S=1.2
# PARTIAL_INTERVAL_S=1.5

# End the turn when the WORDS stop changing: this many consecutive identical partial
# transcripts, on a sentence that does not end mid-thought, count as finished. One more
# identical partial ends the turn even when it does ("where is the"), so a noisy mic can
# never hold a visitor until the 15-second cap.
#
# This is the signal that rescues a turn on a microphone whose room noise reads as continuous
# speech. From a real run on a Realtek mic array: "What is your name?" was asked in two seconds,
# webrtcvad then reported speech for another nineteen, and the turn only ended on the 15-second
# safety cap. Whisper had the full sentence after two seconds and repeated it unchanged three
# times - nobody producing new words for several seconds is still talking, whatever the VAD
# thinks of the room tone.
#
# At PARTIAL_INTERVAL_S=1.5, two of them is about three seconds of silence. Needs STREAMING_STT.
# Set to 0 to switch it off and rely on the VAD and pitch contour alone.
# TURN_STABLE_PARTIALS=2

# Speak each sentence as the model generates it, rather than waiting for the whole answer.
# Turning this off multiplies the wait before the first word by the length of the answer.
# STREAMING_TTS=true
# Shortest fragment worth sending to Piper on its own (characters).
# TTS_MIN_SENTENCE_CHARS=24
# Let the FIRST fragment break at a comma instead of waiting for a full stop - the only fragment
# with nothing already playing in front of it, so the only one where waiting is audible silence.
# TTS_FIRST_CLAUSE_FLUSH=true
# TTS_FIRST_CLAUSE_MIN_CHARS=40

# --- logging ----------------------------------------------------------------------------------
# The tagged real-time trace: [VAD] [TURN] [STT] [LLM] [TTS] [STATE] [INTERRUPTION].
# REALTIME_DEBUG=true
# Whether partial and final transcripts are printed in full rather than as lengths. Set to false
# for an unattended kiosk whose logs are not private - see docs/PRIVACY.md.
# LOG_TRANSCRIPTS=true

# =============================================================================================
# HEARING, SPEAKING AND ATTENTION
# =============================================================================================
# Every value shown is the default. The models these use are fetched once with:
#     python stages/stage00_setup/download_models.py
# and anything missing falls back to the older component, saying so at startup.

# --- devices --------------------------------------------------------------------------------
# Pick the microphone / speaker by name (any part of it) or number, instead of "the Windows
# default", which changes when earbuds connect. List them with:
#     python stages/stage00_setup/list_audio_devices.py
# MIC_DEVICE=
# SPEAKER_DEVICE=
# Read the microphone in its own small process so heavy camera or model work can never make it
# drop audio ("input overflow"). Recommended on a slow computer.
# AUDIO_CAPTURE_PROCESS=false

# --- echo cancellation ----------------------------------------------------------------------
# WebRTC's echo canceller removes the robot's own voice from the microphone, which is what makes
# talking over it (barge-in) and the "mm-hm" back-channels work with ordinary speakers.
# auto = on when the livekit package is installed.
# AEC_ENABLED=auto

# --- speech recognition ---------------------------------------------------------------------
# whisper = faster-whisper (most accurate, best with an NVIDIA GPU).
# sherpa  = streaming Zipformer: words appear while you speak and the final text is ready about
#           50ms after you stop, on any CPU. Less accurate on unusual words (measured in
#           docs/RESULTS.md); the robot's name is boosted as a hotword.
# STT_BACKEND=whisper
# WHISPER_MODEL=small.en
# auto = use an NVIDIA GPU if Whisper actually runs on it (for a GTX 1650 also
#        pip install -r requirements-gpu.txt), otherwise the CPU.
# STT_DEVICE=auto

# Cloud hearing (optional). groq = when a question is finished, it is transcribed by Groq's
# Whisper large-v3 (much bigger than small.en: better with accents, names and a noisy room).
# The partials and the end-of-turn decision stay on this computer, and the local Whisper
# transcribes the same audio at the same time, so a slow or failing Groq costs nothing.
# Needs GROQ_API_KEY above (free key, no card: https://console.groq.com/keys). The free plan
# allows 20 questions a minute and 2,000 a day. A recording of each question is sent to Groq -
# see docs/PRIVACY.md.
# STT_CLOUD=off
# GROQ_STT_MODEL=whisper-large-v3
# Longest the robot waits for Groq before using the local transcript (seconds).
# STT_CLOUD_TIMEOUT_S=3.0

# Background voices: once the visitor has spoken, speech this many dB quieter than their own
# voice (people talking further away) counts as silence, so it cannot hold the turn open.
# Raise it if the robot cuts off a visitor who drops their voice; 0 switches it off.
# VOICE_GATE_DB=25

# --- end of turn ----------------------------------------------------------------------------
# smart_turn = a small model that hears HOW you finished a sentence and answers ~250ms after a
#              clearly finished question, but waits through "um..." and mid-sentence pauses.
# pitch      = the older rule-based detector.
# TURN_DETECTOR=smart_turn
# SMART_TURN_THRESHOLD=0.5
# SMART_TURN_MIN_SILENCE_MS=250

# --- the voice ------------------------------------------------------------------------------
# auto = Kokoro (natural) when its model is downloaded AND this computer synthesizes it at least
# 2x faster than real time; otherwise Piper.
# TTS_BACKEND=auto
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# Keep synthesized audio of fixed lines so a repeat starts instantly.
# TTS_AUDIO_CACHE=true
# +/- speaking-rate variation per sentence, so long answers do not sound mechanical.
# TTS_RATE_VARIATION=0.04
# "Mm, okay" while a slow answer is being prepared. auto = only if the answer is not ready
# FILLER_DELAY_MS after you stopped talking; always = every question; off = never.
# FILLER_MODE=auto
# FILLER_DELAY_MS=700
# A quiet "mm-hm" when you pause mid-sentence. auto = only with echo cancellation on.
# BACKCHANNELS=auto
# BACKCHANNEL_AFTER_MS=600

# --- who is the robot talking to? -----------------------------------------------------------
# face = a light face detector (YuNet) finds people; yolo = the older person detector.
# PRESENCE_BACKEND=face
# Upper limit on vision work per second (lower it on a slow computer).
# VISION_FPS=10
# Greet only people who stop near the robot and look at it for ENGAGE_DWELL_S - not passers-by.
# ENGAGEMENT_GATE=true
# ENGAGE_MIN_FACE_FRACTION=0.05
# ENGAGE_MAX_YAW=0.35
# ENGAGE_DWELL_S=1.0
# Answer only speech from the person facing the robot with moving lips, or speech that uses its
# name. auto = ignore other voices but never go deaf; strict = also ignore voices with no face;
# off = answer everything.
# ADDRESSEE_CHECK=auto
# ADDRESSEE_MIN_LIP_FRACTION=0.25
# Say "I'll be with you in a moment" to somebody who walks up during a conversation.
# ACKNOWLEDGE_NEWCOMERS=true

# --- calling the robot by name --------------------------------------------------------------
# text = the robot's name in what it heard counts as being addressed (no extra model).
# openwakeword = also an always-on wake word detector, so it can be called from off camera.
#                Set OWW_MODEL to a .onnx model ("hey_jarvis" works out of the box; train a
#                "hey nova" model with openWakeWord's notebook for the real thing).
# off = no wake word at all.
# WAKE_WORD_ENGINE=text
# Extra phrases (comma-separated) that count as the robot's name, e.g. misheard spellings.
# WAKE_WORDS=
# OWW_MODEL=
# OWW_THRESHOLD=0.5

# --- language model -------------------------------------------------------------------------
# The order the answer backends are tried in (the first that works answers).
# ANSWER_BACKENDS=groq,gemini,ollama
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_SEARCH=false
# Stream general (non-university) answers word by word like university ones.
# STREAM_GENERAL_ANSWERS=true

# --- screen ---------------------------------------------------------------------------------
# HEADLESS=true for a robot with no monitor: no windows at all (stop with Ctrl+C).
# HEADLESS=false
# The robot's animated face in its own window; FACE_FULLSCREEN for the robot's screen.
# FACE_DISPLAY=true
# FACE_FULLSCREEN=false
# The camera window with boxes drawn on faces (for debugging).
# CAMERA_PREVIEW=true
